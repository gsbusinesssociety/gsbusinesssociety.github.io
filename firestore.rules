rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if the caller is an admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/members/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.role == 'admin';
    }

    // Helper function to check if caller is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Members Collection
    // Anyone logged in can read it (to check their own access)
    // Only admins can modify
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Events Collection
    // Publicly readable so the Events page works for anyone
    // Only admins can modify
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tips and Newsletters
    // Readable by logged in members
    // Writable by admins
    match /tips/{tipId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /newsletters/{newsletterId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Contact Messages
    // Anyone can submit a message (create)
    // Only admins can read or delete them
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
